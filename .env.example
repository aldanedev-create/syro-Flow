# Copy this file to .env and fill in real values before running the project.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SITE_NAME=Syro Flow
SITE_DESCRIPTION=

# Postgres, e.g. postgres://user:password@localhost:5432/syroflow
# Defaults to local SQLite if not set.
DATABASE_URL=sqlite:///db.sqlite3

# Redis/Memcached, e.g. redis://127.0.0.1:6379/1
# Defaults to Django's local-memory cache if not set.
CACHE_URL=

CACHE_MIDDLEWARE_SECONDS=900
CACHE_MIDDLEWARE_KEY_PREFIX=syroflow

# Leave EMAIL_HOST blank in development to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@syroflow.com
CONTACT_EMAIL=
